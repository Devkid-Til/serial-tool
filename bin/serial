# 串口管理工具

CONFIG_FILE="$HOME/.config/serial/devices.conf"
DEFAULT_LOG_DIR="/tmp/serial-logs"

mkdir -p "$DEFAULT_LOG_DIR" "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'EOF'
# Serial 设备配置
# 格式: 别名|by-path路径|波特率|用途|备注
# 用途: terminal（交互终端）或 log-only（日志记录）
# 示例:
#   S100-UART|pci-0000:00:1d.0-usb-0:1:1.0-port0|921600|terminal|S100 主控 UART
EOF
fi

show_help() {
    cat <<EOF
用法: serial <命令> [参数]

设备管理:
  list                                    列出所有配置的设备
  detect                                  扫描设备并交互式配置新设备
  show <别名>                             显示设备详情
  update <别名>                           交互式逐项更新设备配置
  update <别名> <字段> <新值>             命令行模式（字段: path|baud|usage|desc）
  remove <别名>                           删除设备配置

  提示: 自动化场景可直接编辑配置文件，格式见配置文件头部注释

连接操作:
  connect <别名> [波特率]                 连接设备（交互模式）
  raw <设备路径> [波特率]                 直接连接指定设备路径
  monitor [板子名]                        tmux 多窗口监控（无参数=所有设备）

日志管理:
  logs list                               列出所有日志文件
  logs show <设备名|文件名>                查看日志（less）
  logs follow                             实时监控所有日志
  logs clean [天数]                       清理旧日志（默认 7 天）

示例:
  # 设备管理
  serial list
  serial detect                           # 扫描并配置新设备
  serial update S100-UART                 # 交互式更新（回车保持不变）
  serial update S100-UART baud 115200     # 命令行模式（脚本用）
  serial remove S100-UART

  # 连接操作
  serial connect S100-UART
  serial raw /dev/ttyUSB0 115200
  serial monitor S100                 # 监控 S100 的所有串口
  serial monitor                      # 监控所有设备

  # 日志管理
  serial logs list                    # 列出所有日志
  serial logs show S100-BOOT          # 查看 S100-BOOT 最新日志
  serial logs follow                  # 实时监控
  serial logs clean 7                 # 清理 7 天前的日志

配置文件: $CONFIG_FILE
日志目录: $DEFAULT_LOG_DIR
EOF
}

find_device() {
    grep "^$1|" "$CONFIG_FILE" 2>/dev/null | head -1
}

# 根据 by-path 查找设备别名
find_alias_by_path() {
    local search_path="$1"
    while IFS='|' read -r alias path baud usage desc; do
        [[ "$alias" =~ ^#.*$ ]] && continue
        [[ -z "$alias" ]] && continue
        if [ "$path" = "$search_path" ]; then
            echo "$alias"
            return 0
        fi
    done < "$CONFIG_FILE"
    return 1
}

# 获取设备芯片/驱动信息
get_device_info() {
    local dev="$1"
    local info=$(udevadm info -n "$dev" 2>/dev/null)

    local driver=$(echo "$info" | grep "ID_USB_DRIVER=" | cut -d= -f2)
    local vendor=$(echo "$info" | grep "ID_VENDOR_ID=" | cut -d= -f2)
    local model=$(echo "$info" | grep "ID_MODEL=" | cut -d= -f2)
    local serial=$(echo "$info" | grep "ID_SERIAL_SHORT=" | cut -d= -f2)

    # 芯片型号友好名称
    case "$driver" in
        ch341) driver="CH341" ;;
        ftdi_sio) driver="FTDI" ;;
        cp210x) driver="CP210x" ;;
        pl2303) driver="PL2303" ;;
        *) driver="${driver:-unknown}" ;;
    esac

    echo "$driver|$vendor|$model|$serial"
}

# 从已有别名中提取板子前缀并生成建议
generate_suggestions() {
    local suggestions=()
    local prefixes=()

    # 收集所有已有的板子前缀
    while IFS='|' read -r alias _; do
        [[ "$alias" =~ ^#.*$ ]] && continue
        [[ -z "$alias" ]] && continue

        # 提取前缀（如 S100-UART -> S100）
        if [[ "$alias" =~ ^(.+)-(UART|BOOT|CONSOLE|DEBUG|LOG)$ ]]; then
            local prefix="${BASH_REMATCH[1]}"
            # 去重
            local exists=0
            for p in "${prefixes[@]}"; do
                [ "$p" = "$prefix" ] && exists=1 && break
            done
            [ $exists -eq 0 ] && prefixes+=("$prefix")
        fi
    done < "$CONFIG_FILE"

    # 为每个前缀生成所有可能的用途组合
    local suffixes=("UART" "BOOT" "CONSOLE" "DEBUG" "LOG")
    for prefix in "${prefixes[@]}"; do
        for suffix in "${suffixes[@]}"; do
            local candidate="$prefix-$suffix"
            # 跳过已存在的别名
            if [ -z "$(find_device "$candidate")" ]; then
                suggestions+=("$candidate")
            fi
        done
    done

    # 如果没有已有前缀，提供通用建议
    if [ ${#suggestions[@]} -eq 0 ]; then
        suggestions=("BOARD-UART" "BOARD-BOOT" "BOARD-CONSOLE")
    fi

    echo "${suggestions[@]}"
}

# 扫描并交互式配置设备
detect_devices() {
    echo "扫描 USB 串口设备..."
    echo ""

    local devices=()
    local seen_devs=()

    # 扫描所有 by-path 设备（去重）
    for link in /dev/serial/by-path/*; do
        [ ! -e "$link" ] && continue

        local dev=$(readlink -f "$link")
        local path=$(basename "$link")
        local devname=$(basename "$dev")

        # 去重：跳过已见过的设备（usbv1-* 和 usb-* 是同一设备）
        local skip=0
        for seen in "${seen_devs[@]}"; do
            if [ "$seen" = "$devname" ]; then
                skip=1
                break
            fi
        done
        [ $skip -eq 1 ] && continue

        seen_devs+=("$devname")
        devices+=("$devname|$path")
    done

    if [ ${#devices[@]} -eq 0 ]; then
        echo "未检测到 USB 串口设备"
        return 0
    fi

    echo "检测到 ${#devices[@]} 个 USB 串口设备:"
    echo ""

    # 显示所有设备
    local i=1
    local unconfigured=()
    for entry in "${devices[@]}"; do
        IFS='|' read -r devname path <<< "$entry"
        local dev="/dev/$devname"

        echo "[$i] $devname"
        echo "    by-path: $path"

        # 获取设备信息
        IFS='|' read -r driver vendor model serial <<< "$(get_device_info "$dev")"
        echo "    芯片: $driver"
        [ -n "$vendor" ] && echo "    厂商: $vendor"
        [ -n "$model" ] && echo "    型号: $model"
        [ -n "$serial" ] && echo "    序列号: $serial"

        # 检查是否已配置
        local existing_alias=$(find_alias_by_path "$path")
        if [ -n "$existing_alias" ]; then
            echo "    状态: 已配置为 $existing_alias"
        else
            echo "    状态: 未配置"
            unconfigured+=("$devname|$path")
        fi
        echo ""
        ((i++))
    done

    # 交互式配置未配置的设备
    if [ ${#unconfigured[@]} -eq 0 ]; then
        echo "所有设备已配置完成"
        return 0
    fi

    echo "----------------------------------------"
    read -p "是否为未配置的设备创建别名? (y/N): " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        return 0
    fi

    # 生成智能建议
    local suggestions=($(generate_suggestions))

    for entry in "${unconfigured[@]}"; do
        IFS='|' read -r devname path <<< "$entry"

        echo ""
        echo "配置设备 $devname"
        echo "  by-path: $path"

        # 显示建议的别名
        if [ ${#suggestions[@]} -gt 0 ]; then
            echo "  建议的别名:"
            local j=1
            for sugg in "${suggestions[@]}"; do
                echo "    $j) $sugg"
                ((j++))
            done
            echo "    $j) 输入新别名"
            echo "    $((j+1))) 跳过"

            read -p "  请选择 [1-$((j+1))]: " choice

            # 处理选择
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$j" ]; then
                alias="${suggestions[$((choice-1))]}"
            elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$j" ]; then
                read -p "  请输入别名: " alias
                # 验证手动输入的别名
                if ! validate_alias "$alias"; then
                    echo "  跳过此设备"
                    continue
                fi
            else
                echo "  跳过此设备"
                continue
            fi
        else
            read -p "  别名 (留空跳过): " alias
            [ -z "$alias" ] && continue
            # 验证手动输入的别名
            if ! validate_alias "$alias"; then
                echo "  跳过此设备"
                continue
            fi
        fi

        read -p "  波特率 [默认 921600]: " baud
        baud=${baud:-921600}
        # 验证波特率
        if ! validate_baud "$baud"; then
            echo "  跳过此设备"
            continue
        fi

        # 用途选择菜单
        echo "  用途:"
        echo "    1) terminal  - 交互式终端（可输入命令）"
        echo "    2) log-only  - 日志记录（主要用于输出）"
        read -p "  请选择 [1-2, 默认 1]: " usage_choice

        case "${usage_choice:-1}" in
            1) usage="terminal" ;;
            2) usage="log-only" ;;
            *) usage="terminal" ;;
        esac

        read -p "  备注: " desc

        add_device "$alias" "$path" "$baud" "$usage" "$desc"
    done
}

list_devices() {
    if [ ! -s "$CONFIG_FILE" ]; then
        echo "配置文件为空，使用 'serial detect' 添加设备"
        return 0
    fi

    echo "已配置的串口设备:"
    echo "----------------------------------------"
    printf "%-15s %-10s %-12s %s\n" "别名" "波特率" "用途" "备注"
    echo "----------------------------------------"

    while IFS='|' read -r alias path baud usage desc; do
        [[ "$alias" =~ ^#.*$ ]] && continue
        [[ -z "$alias" ]] && continue

        local status="✗"
        [ -e "/dev/serial/by-path/$path" ] && status="✓"

        printf "%-15s %-10s %-12s %s [%s]\n" "$alias" "$baud" "$usage" "$desc" "$status"
    done < "$CONFIG_FILE"

    echo "----------------------------------------"
    echo "[✓] 设备在线  [✗] 设备离线"
}

show_device() {
    local alias="$1"
    local info=$(find_device "$alias")

    if [ -z "$info" ]; then
        echo "错误: 未找到设备 '$alias'"
        return 1
    fi

    IFS='|' read -r _ path baud usage desc <<< "$info"

    echo "设备详情:"
    echo "  别名:     $alias"
    echo "  by-path:  $path"
    echo "  波特率:   $baud"
    echo "  用途:     $usage"
    echo "  备注:     $desc"

    local device="/dev/serial/by-path/$path"
    if [ -e "$device" ]; then
        local actual=$(readlink -f "$device")
        echo "  状态:     在线 ($actual)"
    else
        echo "  状态:     离线"
    fi
}

# 验证别名格式
validate_alias() {
    local alias="$1"

    # 检查是否为空
    if [ -z "$alias" ]; then
        echo "错误: 别名不能为空"
        return 1
    fi

    # 别名只能包含字母、数字、横线、下划线
    if [[ ! "$alias" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "错误: 别名格式非法"
        echo "别名只能包含字母、数字、横线(-)、下划线(_)"
        echo "不允许: 空格、斜杠、特殊字符"
        return 1
    fi

    # 长度限制
    if [ ${#alias} -gt 50 ]; then
        echo "错误: 别名过长（最多 50 字符）"
        return 1
    fi

    return 0
}

# 验证波特率
validate_baud() {
    local baud="$1"

    # 必须是数字
    if [[ ! "$baud" =~ ^[0-9]+$ ]]; then
        echo "错误: 波特率必须是数字"
        return 1
    fi

    # 常见波特率范围
    if [ "$baud" -lt 300 ] || [ "$baud" -gt 4000000 ]; then
        echo "警告: 波特率 $baud 不在常见范围内 (300-4000000)"
        read -p "是否继续? (y/N): " -n 1 -r
        echo
        [[ ! $REPLY =~ ^[Yy]$ ]] && return 1
    fi

    return 0
}

# 验证用途
validate_usage() {
    local usage="$1"

    if [ "$usage" != "terminal" ] && [ "$usage" != "log-only" ]; then
        echo "错误: 用途必须是 terminal 或 log-only"
        return 1
    fi

    return 0
}

# 内部函数：添加设备（由 detect 调用，带验证）
add_device() {
    local alias="$1" path="$2" baud="${3:-115200}" usage="${4:-terminal}" desc="${5:-}"

    if [ -z "$alias" ] || [ -z "$path" ]; then
        echo "错误: 缺少必需参数（别名/by-path路径）"
        return 1
    fi

    # 验证输入
    validate_alias "$alias" || return 1
    validate_baud "$baud" || return 1
    validate_usage "$usage" || return 1

    if [ -n "$(find_device "$alias")" ]; then
        echo "错误: 设备 '$alias' 已存在，使用 'serial update' 修改"
        return 1
    fi

    echo "$alias|$path|$baud|$usage|$desc" >> "$CONFIG_FILE"
    echo "已添加设备: $alias"
    show_device "$alias"
}

# 交互式更新设备（回车保持当前值）
update_device_interactive() {
    local alias="$1"

    local info=$(find_device "$alias")
    if [ -z "$info" ]; then
        echo "错误: 未找到设备 '$alias'"
        echo "运行 'serial list' 查看可用设备"
        return 1
    fi

    IFS='|' read -r _ old_path old_baud old_usage old_desc <<< "$info"

    echo "更新设备 $alias（回车保持不变）"

    # by-path
    read -p "  by-path [$old_path]: " new_path
    new_path=${new_path:-$old_path}

    # 波特率
    read -p "  波特率 [$old_baud]: " new_baud
    new_baud=${new_baud:-$old_baud}
    if ! validate_baud "$new_baud"; then
        echo "已取消"
        return 1
    fi

    # 用途选择菜单
    local current_choice=1
    [ "$old_usage" = "log-only" ] && current_choice=2
    echo "  用途:"
    echo "    1) terminal  - 交互式终端（可输入命令）"
    echo "    2) log-only  - 日志记录（主要用于输出）"
    read -p "  请选择 [1-2, 当前 $current_choice]: " usage_choice
    case "${usage_choice:-$current_choice}" in
        1) new_usage="terminal" ;;
        2) new_usage="log-only" ;;
        *) new_usage="$old_usage" ;;
    esac

    # 备注
    read -p "  备注 [$old_desc]: " new_desc
    new_desc=${new_desc:-$old_desc}

    # 检查是否有变更
    if [ "$new_path" = "$old_path" ] && \
       [ "$new_baud" = "$old_baud" ] && \
       [ "$new_usage" = "$old_usage" ] && \
       [ "$new_desc" = "$old_desc" ]; then
        echo "未做任何修改"
        return 0
    fi

    # 写入配置
    grep -v "^$alias|" "$CONFIG_FILE" > "$CONFIG_FILE.tmp"
    echo "$alias|$new_path|$new_baud|$new_usage|$new_desc" >> "$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

    # 显示变更摘要
    echo "✓ 已更新设备: $alias"
    [ "$new_path" != "$old_path" ]   && echo "  path:  $old_path → $new_path"
    [ "$new_baud" != "$old_baud" ]   && echo "  baud:  $old_baud → $new_baud"
    [ "$new_usage" != "$old_usage" ] && echo "  usage: $old_usage → $new_usage"
    [ "$new_desc" != "$old_desc" ]   && echo "  desc:  $old_desc → $new_desc"
}

update_device() {
    local alias="$1" field="$2" value="$3"

    # 无字段参数时进入交互模式
    if [ -n "$alias" ] && [ -z "$field" ]; then
        update_device_interactive "$alias"
        return $?
    fi

    if [ -z "$alias" ] || [ -z "$field" ] || [ -z "$value" ]; then
        echo "用法: serial update <别名> [字段 新值]"
        echo "  不带字段参数: 交互式逐项更新"
        echo "  字段: path|baud|usage|desc（命令行模式，供脚本使用）"
        return 1
    fi

    local info=$(find_device "$alias")
    if [ -z "$info" ]; then
        echo "错误: 未找到设备 '$alias'"
        return 1
    fi

    IFS='|' read -r _ old_path old_baud old_usage old_desc <<< "$info"

    local new_path="$old_path" new_baud="$old_baud" new_usage="$old_usage" new_desc="$old_desc"

    case "$field" in
        path)  new_path="$value" ;;
        baud)
            validate_baud "$value" || return 1
            new_baud="$value"
            ;;
        usage)
            validate_usage "$value" || return 1
            new_usage="$value"
            ;;
        desc)  new_desc="$value" ;;
        *)
            echo "错误: 未知字段 '$field'"
            echo "可用字段: path|baud|usage|desc"
            return 1
            ;;
    esac

    grep -v "^$alias|" "$CONFIG_FILE" > "$CONFIG_FILE.tmp"
    echo "$alias|$new_path|$new_baud|$new_usage|$new_desc" >> "$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

    echo "已更新设备: $alias"
    show_device "$alias"
}

remove_device() {
    local alias="$1"

    if [ -z "$(find_device "$alias")" ]; then
        echo "错误: 未找到设备 '$alias'"
        return 1
    fi

    grep -v "^$alias|" "$CONFIG_FILE" > "$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

    echo "已删除设备: $alias"
}

connect_device() {
    local alias="$1" custom_baud="$2"

    local info=$(find_device "$alias")
    if [ -z "$info" ]; then
        echo "错误: 未找到设备 '$alias'"
        echo "运行 'serial list' 查看可用设备"
        return 1
    fi

    IFS='|' read -r _ path baud usage desc <<< "$info"

    local device="/dev/serial/by-path/$path"
    if [ ! -e "$device" ]; then
        echo "错误: 设备不在线: $device"
        echo "可用设备:"
        ls -l /dev/serial/by-path/ 2>/dev/null
        return 1
    fi

    local final_baud="${custom_baud:-$baud}"
    local log_file="$DEFAULT_LOG_DIR/${alias}-$(date +%Y%m%d-%H%M%S).log"

    echo "连接设备: $alias ($desc)"
    echo "设备路径: $device"
    echo "波特率: $final_baud"
    echo "日志文件: $log_file"
    echo "提示: Ctrl-T Q 退出"
    echo "----------------------------------------"

    tio -b "$final_baud" -L --log-file "$log_file" --log-strip -t "$device"

    # 退出后提示
    echo ""
    echo "日志已保存: $log_file"
    echo "查看日志: serial logs show $alias"
}

# 日志管理命令组
logs_command() {
    local subcmd="${1:-}"
    shift

    if [ -z "$subcmd" ]; then
        echo "用法: serial logs <子命令> [参数]"
        echo ""
        echo "子命令:"
        echo "  list                    列出所有日志文件"
        echo "  show <设备名|文件名>     查看日志（less）"
        echo "  follow                  实时监控所有日志（tail -f）"
        echo "  clean [天数]            清理旧日志（默认 7 天）"
        echo ""
        echo "示例:"
        echo "  serial logs list"
        echo "  serial logs show S100-BOOT"
        echo "  serial logs show S100-BOOT-20261031-230027"
        echo "  serial logs follow"
        echo "  serial logs clean 7"
        return 0
    fi

    case "$subcmd" in
        list)
            logs_list "$@"
            ;;
        show)
            logs_show "$@"
            ;;
        follow|tail|-f)
            logs_follow "$@"
            ;;
        clean)
            logs_clean "$@"
            ;;
        *)
            echo "错误: 未知子命令 '$subcmd'"
            echo ""
            echo "可用子命令: list, show, follow, clean"
            echo "运行 'serial logs' 查看帮助"
            return 1
            ;;
    esac
}

# 列出所有日志文件
logs_list() {
    local log_dir="$DEFAULT_LOG_DIR"

    if [ ! -d "$log_dir" ] || [ -z "$(ls -A "$log_dir" 2>/dev/null)" ]; then
        echo "没有日志文件"
        echo "提示: 使用 'serial connect <设备>' 连接设备会自动记录日志"
        return 0
    fi

    echo "串口日志文件:"
    echo "--------------------------------------------------------------------------------"
    printf "%-20s %-10s %-20s %s\n" "设备" "大小" "修改时间" "文件名"
    echo "--------------------------------------------------------------------------------"

    local count=0
    for file in $(ls -t "$log_dir"/*.log 2>/dev/null); do
        local basename=$(basename "$file" .log)
        local size=$(du -h "$file" | cut -f1)
        local mtime=$(stat -c %y "$file" 2>/dev/null | cut -d. -f1 || stat -f "%Sm" "$file")

        # 提取设备名（格式：DEVICE-YYYYMMDD-HHMMSS）
        local device=$(echo "$basename" | sed 's/-[0-9]\{8\}-[0-9]\{6\}$//')

        printf "%-20s %-10s %-20s %s\n" "$device" "$size" "$mtime" "$(basename "$file")"
        ((count++))
    done

    echo "--------------------------------------------------------------------------------"
    local total=$(du -sh "$log_dir" 2>/dev/null | cut -f1)
    echo "共 $count 个日志文件，总大小 $total"
    echo "日志目录: $log_dir"
    echo ""
    echo "提示:"
    echo "  serial logs show <设备名>     查看该设备最新日志"
    echo "  serial logs show <文件名>     查看指定日志"
    echo "  serial logs follow            实时监控所有日志"
    echo "  serial logs clean [天数]      清理旧日志（默认 7 天）"
}

# 查看日志文件
logs_show() {
    local target="$1"
    local log_dir="$DEFAULT_LOG_DIR"

    if [ -z "$target" ]; then
        echo "错误: 缺少参数"
        echo "用法: serial logs show <设备名|文件名>"
        return 1
    fi

    local log_file=""

    # 尝试精确匹配（完整文件名）
    if [ -f "$log_dir/$target" ]; then
        log_file="$log_dir/$target"
    elif [ -f "$log_dir/$target.log" ]; then
        log_file="$log_dir/$target.log"
    else
        # 尝试设备名匹配（找最新的）
        log_file=$(ls -t "$log_dir"/${target}*.log 2>/dev/null | head -1)

        if [ -z "$log_file" ]; then
            echo "错误: 未找到日志文件 '$target'"
            echo ""
            echo "可用的日志文件:"
            ls -1 "$log_dir"/*.log 2>/dev/null | xargs -n1 basename | sed 's/^/  /'
            return 1
        fi

        echo "查看设备 '$target' 的最新日志: $(basename "$log_file")"
        echo ""
    fi

    # 用 less 打开（支持搜索、翻页）
    less "$log_file"
}

# 实时监控所有日志
logs_follow() {
    local log_dir="$DEFAULT_LOG_DIR"

    if [ ! -d "$log_dir" ] || [ -z "$(ls -A "$log_dir" 2>/dev/null)" ]; then
        echo "没有日志文件"
        echo "提示: 先使用 'serial connect <设备>' 连接设备"
        return 0
    fi

    echo "实时监控所有设备日志 (Ctrl+C 退出)..."
    echo "--------------------------------------------------------------------------------"

    tail -f "$log_dir"/*.log
}

# 清理旧日志
logs_clean() {
    local days="${1:-7}"
    local log_dir="$DEFAULT_LOG_DIR"

    if [ ! -d "$log_dir" ]; then
        echo "日志目录不存在: $log_dir"
        return 0
    fi

    # 验证天数
    if [[ ! "$days" =~ ^[0-9]+$ ]]; then
        echo "错误: 天数必须是数字"
        return 1
    fi

    echo "清理 $days 天前的日志..."

    local count=$(find "$log_dir" -name "*.log" -mtime +$days | wc -l)

    if [ "$count" -eq 0 ]; then
        echo "没有需要清理的日志"
        return 0
    fi

    echo "找到 $count 个旧日志文件:"
    find "$log_dir" -name "*.log" -mtime +$days -exec ls -lh {} \; | awk '{print "  " $NF " (" $5 ")"}'

    read -p "确认删除? (y/N): " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        find "$log_dir" -name "*.log" -mtime +$days -delete
        echo "已删除 $count 个日志文件"
    else
        echo "取消清理"
    fi
}

connect_raw() {
    local device="$1" baud="${2:-115200}"

    if [ ! -e "$device" ]; then
        echo "错误: 设备不存在: $device"
        return 1
    fi

    local log_file="$DEFAULT_LOG_DIR/raw-$(basename $device)-$(date +%Y%m%d-%H%M%S).log"

    echo "直接连接: $device"
    echo "波特率: $baud"
    echo "日志文件: $log_file"
    echo "----------------------------------------"

    tio -b "$baud" -L --log-file "$log_file" --log-strip -t "$device"
}

# 监控多个设备（tmux 分屏）
monitor_devices() {
    local board="$1"
    local devices=()

    # 收集设备列表
    if [ -n "$board" ]; then
        # 模式1：指定板子
        while IFS='|' read -r alias _; do
            [[ "$alias" =~ ^#.*$ ]] && continue
            [[ -z "$alias" ]] && continue
            [[ "$alias" =~ ^${board}- ]] && devices+=("$alias")
        done < "$CONFIG_FILE"

        if [ ${#devices[@]} -eq 0 ]; then
            echo "错误: 未找到板子 '$board' 的设备"
            echo "运行 'serial list' 查看可用设备"
            return 1
        fi

        local session="serial-${board}"
    else
        # 模式2：所有设备
        while IFS='|' read -r alias _; do
            [[ "$alias" =~ ^#.*$ ]] && continue
            [[ -z "$alias" ]] && continue
            devices+=("$alias")
        done < "$CONFIG_FILE"

        if [ ${#devices[@]} -eq 0 ]; then
            echo "错误: 没有已配置的设备"
            echo "运行 'serial detect' 配置新设备"
            return 1
        fi

        local session="serial-all"
    fi

    # 检查 tmux
    if ! command -v tmux &> /dev/null; then
        echo "错误: 未安装 tmux"
        echo "安装: sudo apt install tmux"
        echo ""
        echo "或者分别运行:"
        for dev in "${devices[@]}"; do
            echo "  serial connect $dev"
        done
        return 1
    fi

    # 检查会话是否已存在
    if tmux has-session -t "$session" 2>/dev/null; then
        echo "会话 '$session' 已存在"
        read -p "是否杀掉重建? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            tmux kill-session -t "$session"
        else
            # 检测是否在 tmux 中
            if [ -n "$TMUX" ]; then
                echo "切换到这个会话..."
                tmux switch-client -t "$session"
            else
                echo "附加到现有会话..."
                tmux attach -t "$session"
            fi
            return 0
        fi
    fi

    local count=${#devices[@]}
    echo "启动监控: $count 个设备"
    echo "设备列表: ${devices[*]}"
    echo ""

    # 创建会话
    tmux new-session -d -s "$session" -n "Monitor"

    # 等待 shell 初始化完成
    sleep 0.5

    # 第一个设备（窗口 1，窗格 1）
    tmux send-keys -t "$session:1.1" "serial connect ${devices[0]}" C-m

    # 根据设备数量分屏
    case $count in
        1)
            # 只有一个设备，直接附加
            ;;
        2)
            # 左右分屏
            tmux split-window -h -t "$session:1"
            sleep 0.3
            tmux send-keys -t "$session:1.2" "serial connect ${devices[1]}" C-m
            ;;
        3)
            # 一上两下
            tmux split-window -v -t "$session:1"
            sleep 0.3
            tmux send-keys -t "$session:1.2" "serial connect ${devices[1]}" C-m
            tmux split-window -h -t "$session:1.2"
            sleep 0.3
            tmux send-keys -t "$session:1.3" "serial connect ${devices[2]}" C-m
            ;;
        4)
            # 2x2 网格
            tmux split-window -h -t "$session:1"
            sleep 0.3
            tmux send-keys -t "$session:1.2" "serial connect ${devices[1]}" C-m
            tmux split-window -v -t "$session:1.1"
            sleep 0.3
            tmux send-keys -t "$session:1.3" "serial connect ${devices[2]}" C-m
            tmux split-window -v -t "$session:1.2"
            sleep 0.3
            tmux send-keys -t "$session:1.4" "serial connect ${devices[3]}" C-m
            ;;
        *)
            # 5+ 设备，自动平铺
            for ((i=1; i<count; i++)); do
                if [ $((i % 2)) -eq 1 ]; then
                    tmux split-window -h -t "$session:1"
                else
                    tmux split-window -v -t "$session:1"
                fi
                sleep 0.3
                tmux send-keys -t "$session:1.$((i+1))" "serial connect ${devices[$i]}" C-m
                # 每添加2个窗格重新布局
                [ $((i % 2)) -eq 0 ] && tmux select-layout -t "$session:1" tiled 2>/dev/null
            done
            tmux select-layout -t "$session:1" tiled
            ;;
    esac

    # 显示操作提示
    cat <<EOF
启动监控: $count 个设备
设备列表: ${devices[*]}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF

    # 检测是否在 tmux 会话中
    if [ -n "$TMUX" ]; then
        # 在 tmux 里，直接切换会话
        tmux switch-client -t "$session"
        return 0
    fi

    # 不在 tmux 里，附加到会话
    tmux attach -t "$session"
}

case "${1:-}" in
    list)    list_devices ;;
    detect)  detect_devices ;;
    show)    [ -z "$2" ] && { show_help; exit 1; }; show_device "$2" ;;
    update)  update_device "$2" "$3" "$4" ;;
    remove)  [ -z "$2" ] && { show_help; exit 1; }; remove_device "$2" ;;
    connect) [ -z "$2" ] && { show_help; exit 1; }; connect_device "$2" "$3" ;;
    logs)    logs_command "$2" "$3" ;;
    raw)     [ -z "$2" ] && { show_help; exit 1; }; connect_raw "$2" "$3" ;;
    monitor) monitor_devices "$2" ;;
    *)       show_help ;;
esac
